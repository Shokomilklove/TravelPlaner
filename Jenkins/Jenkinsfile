pipeline {
    agent any

    environment {
        NAMESPACE      = 'travel-planner'
        HELM_CHART     = 'deploy/helm/travel-planner'

        DOCKER_REGISTRY = 'docker.io/shokomilklove'

        FRONTEND_IMAGE = 'frontend'
        TRIP_IMAGE     = 'trip-service'

        IMAGE_TAG      = "${BUILD_NUMBER}"

        GIT_BRANCH     = 'aws-deployment'

        AI_PLANNER_TIMEOUT = '300'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    set -e

                    echo "=== Git information ==="

                    git status
                    git branch -a
                    git log -1 --oneline

                    echo "=== Current commit ==="
                    git rev-parse HEAD
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    set -e

                    echo "=== Building frontend:${IMAGE_TAG} ==="

                    docker build \
                        -t ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${IMAGE_TAG} \
                        ./frontend

                    docker image inspect \
                        ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${IMAGE_TAG}

                    echo "=== Frontend image built successfully ==="
                '''
            }
        }

        stage('Build Trip Service') {
            steps {
                sh '''
                    set -e

                    echo "=== Building trip-service:${IMAGE_TAG} ==="

                    docker build \
                        -t ${DOCKER_REGISTRY}/${TRIP_IMAGE}:${IMAGE_TAG} \
                        ./services/trip-service

                    docker image inspect \
                        ${DOCKER_REGISTRY}/${TRIP_IMAGE}:${IMAGE_TAG}

                    echo "=== Trip-service image built successfully ==="
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    set -e

                    echo "=== Trivy scan: frontend ==="

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${IMAGE_TAG}

                    echo "=== Trivy scan: trip-service ==="

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        ${DOCKER_REGISTRY}/${TRIP_IMAGE}:${IMAGE_TAG}

                    echo "=== Trivy scans passed ==="
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Logging in to Docker Hub ==="

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "=== Pushing frontend image ==="

                        docker push \
                            ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${IMAGE_TAG}

                        echo "=== Pushing trip-service image ==="

                        docker push \
                            ${DOCKER_REGISTRY}/${TRIP_IMAGE}:${IMAGE_TAG}

                        echo "=== Docker Hub push successful ==="

                        docker logout
                    '''
                }
            }
        }

        stage('Update AWS GitOps Manifest') {
            steps {
                sh '''
                    set -e

                    echo "=== Updating AWS Helm image tag ==="

                    sed -i \
                        "s/^  tag: .*/  tag: \\"${IMAGE_TAG}\\"/" \
                        ${HELM_CHART}/values-aws.yaml

                    echo "=== Updating AI Planner timeout ==="

                    sed -i \
                        "s/^  timeout: .*/  timeout: ${AI_PLANNER_TIMEOUT}/" \
                        ${HELM_CHART}/values-aws.yaml

                    echo "=== AWS image configuration ==="

                    grep -A3 "^image:" \
                        ${HELM_CHART}/values-aws.yaml

                    echo "=== AI Planner configuration ==="

                    grep -A3 "^aiPlanner:" \
                        ${HELM_CHART}/values-aws.yaml

                    echo "=== Git diff ==="

                    git diff -- ${HELM_CHART}/values-aws.yaml
                '''
            }
        }

        stage('Validate Helm') {
            steps {
                sh '''
                    set -e

                    echo "=== Helm lint ==="

                    helm lint \
                        ${HELM_CHART} \
                        -f ${HELM_CHART}/values-aws.yaml

                    echo "=== Helm template ==="

                    helm template \
                        travel-planner \
                        ${HELM_CHART} \
                        --namespace ${NAMESPACE} \
                        -f ${HELM_CHART}/values-aws.yaml \
                        > /tmp/helm-rendered.yaml

                    echo "=== Helm validation successful ==="

                    echo "=== Images in rendered manifests ==="

                    grep "image:" /tmp/helm-rendered.yaml

                    echo "=== AI Planner timeout in rendered manifests ==="

                    grep -R "AI_PLANNER_TIMEOUT" /tmp/helm-rendered.yaml || true
                '''
            }
        }

        stage('Commit GitOps Change') {
            steps {
                sh '''
                    set -e

                    git config user.name "Jenkins"
                    git config user.email "jenkins@local"

                    git add ${HELM_CHART}/values-aws.yaml

                    echo "=== Checking Git changes ==="

                    if git diff --cached --quiet; then
                        echo "No GitOps changes to commit."
                    else
                        git commit \
                            -m "chore: deploy TravelPlanner ${IMAGE_TAG}"

                        echo "=== Git commit created ==="

                        git log -1 --oneline
                    fi
                '''
            }
        }

        stage('Push GitOps Change') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-push',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Preparing GitHub push ==="

                        git branch -f ${GIT_BRANCH} HEAD

                        echo "=== Current branch ==="

                        git branch --show-current

                        echo "=== Current commit ==="

                        git rev-parse HEAD

                        echo "=== Configuring Git authentication ==="

                        cat > /tmp/git-askpass.sh <<'EOF'
#!/bin/sh

case "$1" in
    *Username*)
        echo "$GIT_USERNAME"
        ;;
    *Password*)
        echo "$GIT_PASSWORD"
        ;;
esac
EOF

                        chmod 700 /tmp/git-askpass.sh

                        export GIT_ASKPASS=/tmp/git-askpass.sh
                        export GIT_TERMINAL_PROMPT=0

                        echo "=== Pushing GitOps change to GitHub ==="

                        git push origin ${GIT_BRANCH}

                        echo "=== GitHub push successful ==="

                        rm -f /tmp/git-askpass.sh

                        unset GIT_ASKPASS
                        unset GIT_TERMINAL_PROMPT
                    '''
                }
            }
        }

        stage('Wait for Argo CD') {
            steps {
                sh '''
                    set -e

                    echo "=== Waiting for Argo CD reconciliation ==="

                    sleep 20

                    echo "=== GitOps deployment triggered ==="
                    echo "=== Argo CD will deploy the new version to AWS K3s ==="
                '''
            }
        }
    }

    post {

        always {
            echo "Jenkins CI/CD pipeline finished."
        }

        success {
            echo "=============================================="
            echo " TravelPlanner AWS CI/CD SUCCESS"
            echo "=============================================="
            echo " Frontend image:"
            echo " ${DOCKER_REGISTRY}/${FRONTEND_IMAGE}:${IMAGE_TAG}"
            echo ""
            echo " Trip-service image:"
            echo " ${DOCKER_REGISTRY}/${TRIP_IMAGE}:${IMAGE_TAG}"
            echo ""
            echo " AI Planner timeout:"
            echo " ${AI_PLANNER_TIMEOUT} seconds"
            echo ""
            echo " GitOps branch:"
            echo " ${GIT_BRANCH}"
            echo ""
            echo " Argo CD:"
            echo " deployment triggered"
            echo "=============================================="
        }

        failure {
            echo "=============================================="
            echo " TravelPlanner AWS CI/CD FAILED"
            echo "=============================================="
            echo " Check the Jenkins console output."
            echo "=============================================="
        }
    }
}
