pipeline {
    agent any

    environment {
        NAMESPACE      = 'travel-planner'
        HELM_CHART     = 'deploy/helm/travel-planner'

        FRONTEND_IMAGE = 'frontend'
        TRIP_IMAGE     = 'trip-service'

        IMAGE_TAG      = "${BUILD_NUMBER}"

        GIT_BRANCH     = 'master'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                sh '''
                    set -e

                    echo "=== Git information ==="

                    git status
                    git branch -a
                    git log -1 --oneline

                    echo "=== Current commit ==="
                    git rev-parse HEAD
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                sh '''
                    set -e

                    echo "=== Building frontend:${IMAGE_TAG} ==="

                    docker build \
                        -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                        ./frontend

                    docker image inspect ${FRONTEND_IMAGE}:${IMAGE_TAG}

                    echo "=== Frontend image built successfully ==="
                '''
            }
        }

        stage('Build Trip Service') {
            steps {
                sh '''
                    set -e

                    echo "=== Building trip-service:${IMAGE_TAG} ==="

                    docker build \
                        -t ${TRIP_IMAGE}:${IMAGE_TAG} \
                        ./services/trip-service

                    docker image inspect ${TRIP_IMAGE}:${IMAGE_TAG}

                    echo "=== Trip-service image built successfully ==="
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    set -e

                    echo "=== Trivy scan: frontend ==="

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        ${FRONTEND_IMAGE}:${IMAGE_TAG}

                    echo "=== Trivy scan: trip-service ==="

                    trivy image \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        ${TRIP_IMAGE}:${IMAGE_TAG}

                    echo "=== Trivy scans passed ==="
                '''
            }
        }

        stage('Load Images into Minikube') {
            steps {
                sh '''
                    set -e

                    echo "=== Loading frontend:${IMAGE_TAG} into Minikube ==="

                    docker save ${FRONTEND_IMAGE}:${IMAGE_TAG} | \
                        docker exec -i minikube docker load

                    echo "=== Loading trip-service:${IMAGE_TAG} into Minikube ==="

                    docker save ${TRIP_IMAGE}:${IMAGE_TAG} | \
                        docker exec -i minikube docker load

                    echo "=== Verifying images in Minikube ==="

                    docker exec minikube docker images | \
                        grep -E "frontend|trip-service"

                    echo "=== Images successfully loaded ==="
                '''
            }
        }

        stage('Update GitOps Manifest') {
            steps {
                sh '''
                    set -e

                    echo "=== Updating Helm image tag ==="

                    sed -i \
                        "s/^  tag: .*/  tag: \\"${IMAGE_TAG}\\"/" \
                        ${HELM_CHART}/values.yaml

                    echo "=== New image configuration ==="

                    grep -A2 "^image:" \
                        ${HELM_CHART}/values.yaml

                    echo "=== Git diff ==="

                    git diff -- ${HELM_CHART}/values.yaml
                '''
            }
        }

        stage('Validate Helm') {
            steps {
                sh '''
                    set -e

                    echo "=== Helm lint ==="

                    helm lint ${HELM_CHART}

                    echo "=== Helm template ==="

                    helm template \
                        travel-planner \
                        ${HELM_CHART} \
                        --namespace ${NAMESPACE} \
                        > /tmp/helm-rendered.yaml

                    echo "=== Helm validation successful ==="

                    echo "=== Images in rendered manifests ==="

                    grep "image:" /tmp/helm-rendered.yaml
                '''
            }
        }

        stage('Commit GitOps Change') {
            steps {
                script {
                    sh '''
                        set -e

                        git config user.name "Jenkins"
                        git config user.email "jenkins@local"

                        git add ${HELM_CHART}/values.yaml

                        echo "=== Checking Git changes ==="

                        if git diff --cached --quiet; then
                            echo "No GitOps changes to commit."
                        else
                            git commit \
                                -m "chore: deploy TravelPlanner ${IMAGE_TAG}"

                            echo "=== Git commit created ==="
                            git log -1 --oneline
                        fi
                    '''
                }
            }
        }

        stage('Push GitOps Change') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-push',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "=== Preparing GitHub push ==="

                        git branch -f ${GIT_BRANCH} HEAD

                        echo "=== Current branch ==="
                        git branch --show-current

                        echo "=== Current commit ==="
                        git rev-parse HEAD

                        echo "=== Configuring Git authentication ==="

                        cat > /tmp/git-askpass.sh <<'EOF'
#!/bin/sh

case "$1" in
    *Username*)
        echo "$GIT_USERNAME"
        ;;
    *Password*)
        echo "$GIT_PASSWORD"
        ;;
esac
EOF

                        chmod 700 /tmp/git-askpass.sh

                        export GIT_ASKPASS=/tmp/git-askpass.sh
                        export GIT_TERMINAL_PROMPT=0

                        echo "=== Pushing GitOps change to GitHub ==="

                        git push origin ${GIT_BRANCH}

                        echo "=== GitHub push successful ==="

                        rm -f /tmp/git-askpass.sh

                        unset GIT_ASKPASS
                        unset GIT_TERMINAL_PROMPT
                    '''
                }
            }
        }

        stage('Wait for Argo CD') {
            steps {
                sh '''
                    set -e

                    echo "=== Waiting for Argo CD ==="

                    sleep 15

                    echo "=== Argo CD will reconcile the Git change ==="
                    echo "=== Deployment is controlled by Argo CD ==="
                '''
            }
        }
    }

    post {

        always {
            echo "Jenkins CI pipeline finished."
        }

        success {
            echo "======================================"
            echo " TravelPlanner CI SUCCESS"
            echo "======================================"
            echo " Frontend image: frontend:${IMAGE_TAG}"
            echo " Trip image:     trip-service:${IMAGE_TAG}"
            echo " GitOps change:  pushed to GitHub"
            echo " Argo CD:        will deploy the change"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo " TravelPlanner CI FAILED"
            echo "======================================"
            echo " Check the Jenkins console output."
            echo "======================================"
        }
    }
}
